pipeline {
    agent any

    tools {
        jdk   'jdk 21'
        maven 'Maven 3.9.9'
    }

    environment {
        IMAGE = "neeraj91/${JOB_NAME}:v1.${BUILD_ID}"
    }

    stages {

        stage('Checkout') {
            steps {
              
               checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                sh 'mvn clean install -DskipTests -B'
                
            }
        }

        stage('Nexus Deploy') {

            steps {

                sh 'mvn deploy -DskipTests'
            }
        }

        // Merged: Docker build + tag into one stage
        stage('Docker Build & Tag') {
            steps {
                sh "docker build -t ${IMAGE} ."
            }
        }

        // Merged: Docker login + push using credentials (no hardcoded password)
        stage('Docker Push') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                    sh "docker push ${IMAGE}"
                }
            }
        }

     /*   stage('Terraform') {
          steps  {
            dir('demo/terraform') {
               sh 'terraform init '
               sh 'terraform plan ' 
               sh  'terraform apply --auto - approve' 
            }
        }
        }

        stage('push artifact to s3') {
            steps {
                dir('demo') {
                    sh 'zip -r app.zip .'
                    sh 'aws s3 cp app.zip s3://neeraj-react-artifacts-1234/'
                }
            }

        }
        */

        stage('Deploy') {
            
            steps {
                withCredentials([aws(accessKeyVariable: 'AWS_ACCESS_KEY_ID', credentialsId: 'aws-creds', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {

                  sh '''

                    aws eks update-kubeconfig --name test-cluster --region ap-southeast-1
                    kubectl apply -f deployment.yaml
                    kubectl apply -f service.yaml

                 '''
                }
            }
        }
    
    }

    post {

         always 
     {
            cleanWs()
        }
    }
}